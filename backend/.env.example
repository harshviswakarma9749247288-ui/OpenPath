# ==========================================
# OpenPath Backend Environment Example
# Copy this file to .env and adjust variables as needed:
# cp .env.example .env
# ==========================================

# Server Port & Environment
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB local daemon or MongoDB Atlas)
# Local: mongodb://127.0.0.1:27017/openpath
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/openpath?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/openpath

# JWT Authentication Secret & Expiration
# Note: In production, generate a strong random secret
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Client Application URL (CORS & Cookie Whitelist)
CLIENT_URL=http://localhost:3000

# Email Delivery Configuration (Brevo HTTPS API or SMTP Relay)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_email@gmail.com
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_login
SMTP_PASS=your_smtp_key
EMAIL_FROM="OpenPath <noreply@openpath.dev>"

# Local AI Agent Configuration (Ollama / Local LLM Runner)
LOCAL_AI_BASE_URL=http://localhost:11434
LOCAL_AI_MODEL=llama3.2
LOCAL_AI_TIMEOUT=30000