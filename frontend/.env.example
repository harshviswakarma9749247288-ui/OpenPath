# ===========================================
# OpenPath Frontend Environment Example
# Copy this file to .env and adjust variables as needed:
# cp .env.example .env
# ===========================================

# Backend API Base URL (must point to backend REST API /api endpoint)
VITE_API_URL=http://localhost:5000/api

# Application Metadata
VITE_APP_TITLE=OpenPath - Career Discovery & Skill Guidance

# Development Server Port
VITE_PORT=3000
