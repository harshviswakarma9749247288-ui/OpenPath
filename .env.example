# ==============================================================================
# OpenPath Monorepo Environment Variables Reference
# ==============================================================================
# This project contains separate environment files for frontend and backend:
#
# 1. Backend Environment (.env located at backend/.env)
#    Copy backend/.env.example to backend/.env
#
#    PORT=5000
#    NODE_ENV=development
#    MONGODB_URI=mongodb://127.0.0.1:27017/openpath
#    JWT_SECRET=your_jwt_secret_key_here
#    JWT_EXPIRES_IN=7d
#    CLIENT_URL=http://localhost:3000
#
# 2. Frontend Environment (.env located at frontend/.env)
#    Copy frontend/.env.example to frontend/.env
#
#    VITE_API_URL=http://localhost:5000/api
#    VITE_APP_TITLE=OpenPath - Career Discovery & Skill Guidance
#    VITE_PORT=3000
# ==============================================================================
